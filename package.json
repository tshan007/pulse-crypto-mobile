{
  "name": "PulseCrypto",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "dotenv-cli": "^11.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "dotenv -c development -- expo start",
    "start:uat": "dotenv -c uat -- expo start",
    "start:prd": "dotenv -c production -- expo start",
    "start:debug": "dotenv -c debug -- expo start",
    "android": "npm run android:dev",
    "android:dev": "dotenv -c development -- npx expo run:android",
    "android:uat": "dotenv -c uat -- npx expo run:android",
    "android:prd": "dotenv -c production -- npx expo run:android",
    "android:debug": "dotenv -c debug -- npx expo run:android",
    "ios": "npm run ios:dev",
    "ios:dev": "dotenv -c development -- npx expo run:ios",
    "ios:uat": "dotenv -c uat -- npx expo run:ios",
    "ios:prd": "dotenv -c production -- npx expo run:ios",
    "ios:debug": "dotenv -c debug -- npx expo run:ios",
    "web": "npm run web:dev",
    "web:dev": "dotenv -c development -- npx expo start --web",
    "web:debug": "dotenv -c debug -- npx expo start --web"
  },
  "private": true
}
